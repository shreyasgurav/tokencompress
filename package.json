{
  "name": "tokencompress",
  "version": "2.1.0",
  "description": "Automatic token compression for AI agent tool outputs. 60-90% fewer tokens, full explainability.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    }
  },
  "bin": {
    "tokencompress": "dist/cli.js"
  },
  "files": [
    "dist",
    "model/output/tokencompress-minilm/onnx/model_quantized.onnx",
    "model/output/tokencompress-minilm/onnx/config.json",
    "model/output/tokencompress-minilm/onnx/tokenizer.json",
    "model/output/tokencompress-minilm/onnx/tokenizer_config.json",
    "model/output/tokencompress-minilm/onnx/vocab.txt",
    "model/output/tokencompress-minilm/onnx/special_tokens_map.json",
    "model/output/tokencompress-minilm/onnx/ort_config.json",
    "model/output/tokencompress-minilm/config.json",
    "model/output/tokencompress-minilm/tokenizer.json",
    "model/output/tokencompress-minilm/tokenizer_config.json",
    "model/output/tokencompress-minilm/vocab.txt",
    "model/output/tokencompress-minilm/special_tokens_map.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "validate": "vitest run tests/validation/",
    "benchmark": "npx tsx benchmarks/squad.ts",
    "benchmark:quick": "npx tsx benchmarks/squad.ts --limit 20",
    "benchmark:long": "npx tsx benchmarks/longdoc.ts",
    "benchmark:dj": "npx tsx benchmarks/dj.ts",
    "benchmark:testconvo": "npx tsx benchmarks/testconvo.ts",
    "benchmark:compare": "npx tsx benchmarks/compare.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "llm",
    "agent",
    "tool-output",
    "compression",
    "tokens",
    "context",
    "ai-agent",
    "tiktoken",
    "prompt",
    "optimization",
    "explainable",
    "vercel-ai",
    "langchain",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "commander": "^12.1.0",
    "js-tiktoken": "^1.0.15",
    "onnxruntime-node": "^1.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "node-fetch": "^3.3.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
